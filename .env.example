# Required in production. On Vercel the Neon integration sets DATABASE_URL (or POSTGRES_URL) for you.
DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/dbname
SECRET_KEY=generate_a_long_random_string
# The scheduled jobs (reminders, SLA checks, auto-closing) run off normal traffic every 5 minutes on Vercel.
# AUTO_TICK=on runs them that way elsewhere too; off turns it off.
AUTO_TICK=
# Required outside local SQLite: the app refuses to start without SECRET_KEY and CRON_SECRET.
# CRON_SECRET guards /internal/tick (the daily Vercel cron, or an external cron service).
CRON_SECRET=your_super_secret_string
# Not on Vercel and behind a reverse proxy (Render, Fly, nginx)? Set the number of proxies in front of the app (usually 1).
# Left at 0 behind a proxy, every visitor shares the proxy's IP and one person's failed logins lock everyone out.
TRUSTED_PROXY_COUNT=0

# The site's address, used in emailed links. On Vercel it defaults to the production domain.
PUBLIC_APP_URL=https://your-app.vercel.app
# /requests is a public board of every request (titles, status and dates, nothing personal). Set to off to hide it.
PUBLIC_BOARD=on
# Only needed when the frontend is served from a different domain than the API (not on Vercel).
ALLOWED_ORIGINS=

# DesignDesk is for MCCIA only: just these email domains can submit requests, get a sign-in link or be given an
# account (comma-separated). Existing accounts keep signing in. Defaults to mcciapune.com.
ALLOWED_EMAIL_DOMAINS=mcciapune.com

# First admin (Design Lead). ADMIN_PASSWORD is used only to create the account; remove it afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MCCIA Admin
# Recovery: a one-time temporary password for ADMIN_EMAIL, applied on the next start. Remove it after signing in.
ADMIN_RESET_PASSWORD=


# File storage. With S3_ENDPOINT_URL set, files go to S3 / Cloudflare R2. Otherwise: the database on Vercel,
# local disk (UPLOAD_DIR) elsewhere. FILE_STORAGE=database or disk overrides that choice.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=auto
S3_BUCKET_NAME=designflow
FILE_STORAGE=
# Google Drive for new uploads; see DEPLOY.md. Takes priority over S3. Set the folder plus ONE of: GOOGLE_DRIVE_OAUTH
# (your own Drive: the line `python drive_connect.py` prints) or GOOGLE_DRIVE_CREDENTIALS (a service account's JSON key,
# for a Shared Drive).
GOOGLE_DRIVE_OAUTH=
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=
UPLOAD_DIR=
# Upload limits (MB): attachments/proofs, and source files (CDR/PSD/AI). Big files travel in 3 MB pieces, so these hold on Vercel too.
MAX_UPLOAD_MB=10
MAX_CDR_UPLOAD_MB=50

# Emails: confirmations, review links, reminders, forgot password, "My requests" links.
# Zoho Mail: host smtp.zoho.in (or smtp.zoho.com), port 465, SMTP_SSL=true, SMTP_FROM = the same mailbox as SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Optional: CAPTCHA on the public /request form (Cloudflare Turnstile). Both keys are needed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Jira two-way sync
JIRA_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Sign-in session length in hours
TOKEN_TTL_HOURS=12
# How long an emailed client sign-in link works, in minutes (15-60). Each link works once.
CLIENT_LINK_TTL_MINUTES=30
