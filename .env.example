DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/dbname
CRON_SECRET=your_super_secret_string

# S3-compatible API (Cloudflare R2, Supabase Storage, AWS S3)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION_NAME=auto
S3_BUCKET_NAME=designflow-cdr

# Auth / CORS / links
SECRET_KEY=generate_a_long_random_string
ALLOWED_ORIGINS=https://your-frontend.onrender.com
PUBLIC_APP_URL=https://your-frontend.onrender.com
JIRA_WEBHOOK_SECRET=
# Optional: mirror ticket status changes onto linked Jira issues
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# First-run seeding on a non-SQLite database requires these
SEED_STAFF_PASSWORD=
SEED_CLIENT_PASSWORD=

# File uploads: uses S3_* above when S3_ENDPOINT_URL is set, otherwise local disk (UPLOAD_DIR).
# Free hosts wipe local disk on every deploy, so use S3/R2 in production.
UPLOAD_DIR=
MAX_UPLOAD_MB=10

# Optional: confirmation / reminder emails (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Optional: CAPTCHA on the public /request form (Cloudflare Turnstile). Both keys are needed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upload limits (MB): attachments/proofs, and source files (CDR/PSD/AI)
MAX_UPLOAD_MB=10
MAX_CDR_UPLOAD_MB=50
